{
	"name": "win-exec-mcp",
	"displayName": "WinExec MCP for Remote-SSH",
	"description": "%ext.description%",
	"version": "0.4.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/a563471014-sketch/remote-ssh-win-exec-mcp"
	},
	"license": "MIT",
	"publisher": "a563471014-sketch",
	"icon": "icon.png",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Other"
	],
	"extensionKind": [
		"ui"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./extension.js",
	"l10n": "./l10n",
	"contributes": {
		"commands": [
			{
				"command": "winExecMcp.startHttp",
				"title": "%cmd.startHttp.title%"
			},
			{
				"command": "winExecMcp.stopHttp",
				"title": "%cmd.stopHttp.title%"
			},
			{
				"command": "winExecMcp.register",
				"title": "%cmd.register.title%"
			},
			{
				"command": "winExecMcp.registerProject",
				"title": "%cmd.registerProject.title%"
			},
			{
				"command": "winExecMcp.unregisterProject",
				"title": "%cmd.unregisterProject.title%"
			},
			{
				"command": "winExecMcp.setupExternal",
				"title": "%cmd.setupExternal.title%"
			},
			{
				"command": "winExecMcp.setup",
				"title": "%cmd.setup.title%"
			},
			{
				"command": "winExecMcp.fixFirewall",
				"title": "%cmd.fixFirewall.title%"
			}
		],
		"configuration": {
			"title": "WinExec MCP",
			"properties": {
				"winExecMcp.stdio.enabled": {
					"type": "boolean",
					"default": false,
					"description": "%config.stdio.enabled.description%"
				},
				"winExecMcp.http.enabled": {
					"type": "boolean",
					"default": false,
					"description": "%config.http.enabled.description%"
				},
				"winExecMcp.http.port": {
					"type": "number",
					"default": 38848,
					"description": "%config.http.port.description%"
				},
				"winExecMcp.http.token": {
					"type": "string",
					"default": "",
					"description": "%config.http.token.description%"
				},
				"winExecMcp.http.host": {
					"type": "string",
					"default": "",
					"description": "%config.http.host.description%"
				},
				"winExecMcp.ssh.localPort": {
					"type": "number",
					"default": 28848,
					"description": "%config.ssh.localPort.description%"
				}
			}
		}
	}
}
